#!/usr/bin/env python3
# ==============================================================================
# chomp-fetch: Custom High-Density Cyber-Swamp Terminal Fetch for CHOMP_0x
# ==============================================================================
import os
import platform
import re
import subprocess
import sys

# High-Readability ANSI 24-bit TrueColor Escapes
G    = "\033[38;2;57;255;20m"    # Toxic Neon Green (#39ff14)
W    = "\033[38;2;240;251;245m"  # Crisp Specular White (#f0fbf5)
MINT = "\033[38;2;110;231;183m"  # Sharp Cyber Mint (#6ee7b7)
Y    = "\033[38;2;255;176;0m"    # Alert/Hazard Amber (#ffb000)
C    = "\033[38;2;0;255;204m"    # Laser Cyan (#00ffcc)
GR   = "\033[38;2;120;145;135m"  # Readable Tactical Slate/Sage (#789187)
R    = "\033[0m"
BOLD = "\033[1m"
DIM  = "\033[2m"

def get_uptime():
    try:
        with open("/proc/uptime", "r") as f:
            seconds = float(f.readline().split()[0])
        hrs = int(seconds // 3600)
        mins = int((seconds % 3600) // 60)
        return f"{hrs}h {mins}m"
    except Exception:
        return "unknown"

def get_memory():
    try:
        mem_total, mem_avail = 0, 0
        with open("/proc/meminfo", "r") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    mem_total = int(line.split()[1])
                elif line.startswith("MemAvailable:"):
                    mem_avail = int(line.split()[1])
        used = (mem_total - mem_avail) / 1024 / 1024
        total = mem_total / 1024 / 1024
        pct = (used / total) * 100 if total > 0 else 0
        bars = int(pct / 10)
        bar_str = "[" + "=" * bars + "-" * (10 - bars) + "]"
        return f"{used:.1f}G / {total:.1f}G {bar_str}"
    except Exception:
        return "unknown"

def get_packages():
    try:
        out = subprocess.check_output("pacman -Qq 2>/dev/null | wc -l", shell=True).decode().strip()
        return f"{out} (pacman)"
    except Exception:
        return "N/A"

def main():
    user = os.getenv("USER", "jaws")
    hostname = platform.node()
    os_name = "Arch Linux x86_64"
    kernel = platform.release()
    uptime = get_uptime()
    memory = get_memory()
    packages = get_packages()
    shell = os.path.basename(os.getenv("SHELL", "zsh"))
    term = os.getenv("TERM", "kitty")

    ans_paths = [
        os.path.expanduser("~/.config/fastfetch/chomp_big.ans"),
        os.path.expanduser("~/.config/fastfetch/chomp.ans"),
    ]
    ans_path = next((p for p in ans_paths if os.path.exists(p)), None)
    mascot_lines = []
    ansi_escape = re.compile(r"\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])")

    if ans_path and os.path.exists(ans_path):
        try:
            with open(ans_path, "r", encoding="utf-8", errors="replace") as f:
                for line in f:
                    clean = line.replace("\x1b[?25l", "").replace("\x1b[?25h", "").rstrip("\r\n")
                    if ansi_escape.sub("", clean).strip():
                        mascot_lines.append(clean)
        except Exception:
            pass

    if not mascot_lines:
        mascot_lines = [
            r"         _..---.._        ",
            r"       .'  _   _  '.      ",
            r"      /   (o) (o)   \     ",
            r"     |     _..._     |    ",
            r"      \  .'  ^  '.  /     ",
            r"     _.' `'-...-'` '._    ",
            r"   .'                 '.  ",
            r"  /   /             \   \ ",
            r" |   |               |   |",
            r"  \   \  _       _  /   / ",
            r"   '.  '(_)'   '(_)'  .'  ",
            r"     '--..._____...--'    ",
            r"            \ \           ",
            r"             \ \          ",
            r"              \ \____     ",
            r"               '-----'    ",
        ]

    mascot_width = max(len(ansi_escape.sub("", line)) for line in mascot_lines) if mascot_lines else 140

    div_len = 60
    div_line = f"{GR}" + "-" * div_len + f"{R}"

    info_lines = [
        f"{BOLD}{Y}[STATUS: FULL COUCHLOCK]{R}",
        f"{BOLD}{C}[SYS_BREACH: 0x_CHOMP_v2.0]{R}",
        div_line,
        f"{G}[ HOST ]{R} ❯ {W}{user}@{hostname}{R} {GR}// chassis: matte-black{R}",
        f"{G}[ OS   ]{R} ❯ {W}{os_name}{R} {GR}// AwesomeWM 4.3{R}",
        f"{G}[ KRNL ]{R} ❯ {W}{kernel}{R}",
        f"{G}[ UPTM ]{R} ❯ {W}{uptime}{R}",
        f"{G}[ PACK ]{R} ❯ {W}{packages}{R}",
        f"{G}[ SHEL ]{R} ❯ {W}{shell}{R} {GR}// starship [CHOMP_0x]{R}",
        f"{G}[ TERM ]{R} ❯ {W}{term}{R} {GR}// BigBlueTermPlus Nerd Font{R}",
        f"{G}[ MEM  ]{R} ❯ {MINT}{memory}{R}",
        div_line,
        f"{G}████{MINT}████{C}████{Y}████{GR}████{W}████{R}",
    ]

    try:
        term_cols = int(os.getenv("COLUMNS", "0")) or os.get_terminal_size().columns
    except Exception:
        term_cols = 160

    print()
    if term_cols >= mascot_width + 45:
        # Side-by-side layout with stats vertically centered
        offset = max(0, (len(mascot_lines) - len(info_lines)) // 2)
        max_rows = max(len(mascot_lines), len(info_lines) + offset)
        for i in range(max_rows):
            if i < len(mascot_lines):
                line = mascot_lines[i]
                vis_len = len(ansi_escape.sub("", line))
                pad = " " * max(0, mascot_width - vis_len)
                l = f"{line}{pad}"
            else:
                l = " " * mascot_width
            info_idx = i - offset
            r = info_lines[info_idx] if 0 <= info_idx < len(info_lines) else ""
            print(f" {l}{R}   {r}")
    else:
        # Stacked layout when horizontal space is constrained
        for line in mascot_lines:
            print(f" {line}{R}")
        print()
        for line in info_lines:
            print(f"   {line}")
    print()

if __name__ == "__main__":
    main()
