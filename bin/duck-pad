#!/usr/bin/env bash
# ==============================================================================
# darkwing-pad: Interactive Terminal Dropdown for Darkwing Duck
# ==============================================================================
set -e

# Run Darkwing ASCII/ANSI banner
if [ -x "$HOME/.local/bin/darkwing-fetch" ]; then
    "$HOME/.local/bin/darkwing-fetch"
fi

# Keep interactive shell alive
exec "${SHELL:-/bin/zsh}" -i
