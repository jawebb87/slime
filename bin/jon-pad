#!/usr/bin/env bash
# ==============================================================================
# jon-pad: Interactive Terminal Dropdown for I'm Sorry Jon
# ==============================================================================
set -e

# Run I'm Sorry Jon ASCII/ANSI banner
if [ -x "$HOME/.local/bin/jon-fetch" ]; then
    "$HOME/.local/bin/jon-fetch"
fi

# Keep interactive shell alive
exec "${SHELL:-/bin/zsh}" -i
