#!/usr/bin/env bash
# ==============================================================================
# tmnt-pad: Interactive Terminal Dropdown for Teenage Mutant Ninja Turtles
# ==============================================================================
set -e

# Run TMNT ASCII/ANSI banner
if [ -x "$HOME/.local/bin/tmnt-fetch" ]; then
    "$HOME/.local/bin/tmnt-fetch"
fi

# Keep interactive shell alive
exec "${SHELL:-/bin/zsh}" -i
