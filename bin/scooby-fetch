#!/usr/bin/env python3
# ==============================================================================
# mystery-fetch: Scooby-Doo & The Mystery Machine Terminal Fetch
# ==============================================================================
import os
import platform
import re
import subprocess
import sys

# High-Readability TrueColor ANSI Escapes based on Mystery Machine Palette
CYAN    = "\033[38;2;28;209;190m"   # Mystery Machine Turquoise (#1cd1be)
LIME    = "\033[38;2;136;226;44m"   # Groovy Lime Green (#88e22c)
ORANGE  = "\033[38;2;255;119;0m"    # Flower Power Tangerine Orange (#ff7700)
PURPLE  = "\033[38;2;176;98;255m"   # Spooky Night Violet (#b062ff)
GOLD    = "\033[38;2;255;208;0m"    # Scooby Snack Gold (#ffd000)
RED     = "\033[38;2;255;56;100m"   # Spooky Alert Red (#ff3864)
WHITE   = "\033[38;2;255;255;255m"  # Crisp White (#ffffff)
TEXT    = "\033[38;2;212;229;234m"  # Spectral Cream-Cyan (#d4e5ea)
DIM     = "\033[38;2;107;133;148m"  # Muted Midnight Slate (#6b8594)
DIVIDER = "\033[38;2;29;44;58m"     # Midnight Container Border (#1d2c3a)
R       = "\033[0m"
BOLD    = "\033[1m"

def get_uptime():
    try:
        with open("/proc/uptime", "r") as f:
            seconds = float(f.readline().split()[0])
        hrs = int(seconds // 3600)
        mins = int((seconds % 3600) // 60)
        return f"{hrs}h {mins}m"
    except Exception:
        return "unknown"

def get_memory():
    try:
        mem_total, mem_avail = 0, 0
        with open("/proc/meminfo", "r") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    mem_total = int(line.split()[1])
                elif line.startswith("MemAvailable:"):
                    mem_avail = int(line.split()[1])
        used = (mem_total - mem_avail) / 1024 / 1024
        total = mem_total / 1024 / 1024
        pct = (used / total) * 100 if total > 0 else 0
        bars = int(pct / 10)
        bar_str = "[" + "=" * bars + "-" * (10 - bars) + "]"
        return f"{used:.1f}G / {total:.1f}G {bar_str}"
    except Exception:
        return "unknown"

def get_packages():
    try:
        out = subprocess.check_output("pacman -Qq 2>/dev/null | wc -l", shell=True).decode().strip()
        return f"{out} (pacman)"
    except Exception:
        return "N/A"

def main():
    user = os.getenv("USER", "jaws")
    hostname = platform.node()
    os_name = "Arch Linux x86_64"
    kernel = platform.release()
    uptime = get_uptime()
    memory = get_memory()
    packages = get_packages()
    shell = os.path.basename(os.getenv("SHELL", "zsh"))
    term = os.getenv("TERM", "alacritty")

    ans_paths = [
        os.path.expanduser("~/.config/fastfetch/mystery.ans"),
        os.path.expanduser("~/.config/fastfetch/mystery_big.ans"),
    ]
    ans_path = next((p for p in ans_paths if os.path.exists(p)), None)
    mascot_lines = []
    ansi_escape = re.compile(r"\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])")

    if ans_path and os.path.exists(ans_path):
        try:
            with open(ans_path, "r", encoding="utf-8", errors="replace") as f:
                for line in f:
                    clean = line.replace("\x1b[?25l", "").replace("\x1b[?25h", "").rstrip("\r\n")
                    if ansi_escape.sub("", clean).strip():
                        mascot_lines.append(clean)
        except Exception:
            pass

    if not mascot_lines:
        mascot_lines = [
            rf"        {CYAN}.-'\"'-.{R}        ",
            rf"     {CYAN}.-'{LIME}.-'\"'-.{CYAN}'-.     {R}",
            rf"   {CYAN}/ {LIME}/ {ORANGE}.-'\"'-.{LIME} \\ {CYAN}\   {R}",
            rf"  {CYAN}| {LIME}| {ORANGE}| {GOLD} (o.o) {ORANGE} | {LIME}| {CYAN}|  {R}",
            rf"  {CYAN}| {LIME}| {ORANGE}| {GOLD}  > ^ <  {ORANGE}| {LIME}| {CYAN}|  {R}",
            rf"   {CYAN}\\ {LIME}\\ {ORANGE}'-...-' {LIME}/ {CYAN}/   {R}",
            rf"     {CYAN}'-.{LIME}'.....'{CYAN}.-'     {R}",
            rf"        {CYAN}'-----'        {R}",
            rf"     {ORANGE}🌸 [SCOOBY-DOO!] 🌸{R}",
        ]

    mascot_width = max(len(ansi_escape.sub("", line)) for line in mascot_lines) if mascot_lines else 44

    div_len = 54
    div_line = f"{DIVIDER}" + "─" * div_len + f"{R}"

    info_lines = [
        f"{BOLD}{CYAN}🔍 SCENE: SPOOKY MIDNIGHT ROAD & HAUNTED MANOR{R}",
        f"{BOLD}{ORANGE}🚐 VAN: THE MYSTERY MACHINE // GROOVY FLOWER POWER{R}",
        div_line,
        f"{CYAN}[ SCOOB]{R} ❯ {WHITE}{user}@{hostname}{R} {DIM}// ruh-roh, raggy!{R}",
        f"{CYAN}[ REALM]{R} ❯ {TEXT}{os_name}{R} {DIM}// AwesomeWM 4.3{R}",
        f"{CYAN}[ KRNL ]{R} ❯ {TEXT}{kernel}{R}",
        f"{CYAN}[ UPTM ]{R} ❯ {GOLD}{uptime}{R}",
        f"{CYAN}[ PACK ]{R} ❯ {TEXT}{packages}{R}",
        f"{CYAN}[ SHEL ]{R} ❯ {TEXT}{shell}{R} {DIM}// starship [SCOOBY//MYSTERY]{R}",
        f"{CYAN}[ TERM ]{R} ❯ {TEXT}{term}{R} {DIM}// ComicShannsMono Nerd Font{R}",
        f"{CYAN}[ SNACK]{R} ❯ {LIME}{memory}{R}",
        div_line,
        f"{CYAN}████{LIME}████{ORANGE}████{PURPLE}████{GOLD}████{RED}████{TEXT}████{DIM}████{R}",
    ]

    try:
        term_cols = int(os.getenv("COLUMNS", "0")) or os.get_terminal_size().columns
    except Exception:
        term_cols = 120

    print()
    if term_cols >= mascot_width + 50:
        offset = max(0, (len(mascot_lines) - len(info_lines)) // 2)
        max_rows = max(len(mascot_lines), len(info_lines) + offset)
        for i in range(max_rows):
            left = ""
            if i < len(mascot_lines):
                line = mascot_lines[i]
                vis_len = len(ansi_escape.sub("", line))
                pad = " " * max(0, mascot_width - vis_len)
                left = line + pad + "   "
            else:
                left = " " * (mascot_width + 3)

            info_idx = i - offset
            right = ""
            if 0 <= info_idx < len(info_lines):
                right = info_lines[info_idx]

            print(f" {left}{right}")
    else:
        for line in mascot_lines:
            print(f" {line}")
        print()
        for line in info_lines:
            print(f" {line}")
    print()

if __name__ == "__main__":
    main()
