#!/usr/bin/env bash
# ==============================================================================
# mystery-pad: Interactive Terminal Dropdown for Scooby-Doo Mystery Machine
# ==============================================================================
set -e

# Run Mystery ASCII/ANSI banner
if [ -x "$HOME/.local/bin/mystery-fetch" ]; then
    "$HOME/.local/bin/mystery-fetch"
fi

# Keep interactive shell alive
exec "${SHELL:-/bin/zsh}" -i
