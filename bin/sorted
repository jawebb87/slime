    ".bash": "Code",
    ".zsh": "Code",
    ".c": "Code",
    ".cpp": "Code",
    ".h": "Code",
    ".hpp": "Code",
    ".rs": "Code",
    ".go": "Code",
    ".java": "Code",
    ".js": "Code",
    ".ts": "Code",
    ".html": "Code",
    ".css": "Code",
    ".json": "Code",
    ".yaml": "Code",
    ".yml": "Code",
    ".toml": "Code",
    ".xml": "Code",
    ".sql": "Code",
    ".diff": "Code",
    ".patch": "Code",
    # Torrents
    ".torrent": "Torrents",
    # Fonts
    ".ttf": "Fonts",
    ".otf": "Fonts",
    ".woff": "Fonts",
    ".woff2": "Fonts",
}

# Temporary or in-progress download extensions to strictly skip
IGNORE_EXTENSIONS: Set[str] = {
    ".crdownload",
    ".part",
    ".tmp",
    ".download",
    ".torrent.part",
    ".aria2",
    "!ut",
}


def split_filename_and_ext(filename: str) -> Tuple[str, str]:
    """
    Split a filename into (stem, ext), supporting multi-part compound extensions
    such as '.tar.gz', '.tar.xz', etc.
    """
    lower = filename.lower()
    for compound in COMPOUND_EXTENSIONS:
        if lower.endswith(compound):
            return filename[: -len(compound)], filename[-len(compound) :]
    p = Path(filename)
    return p.stem, p.suffix


def get_file_extension(filename: str) -> str:
    """Return the normalized lowercase extension (single or compound) of a filename."""
    _, ext = split_filename_and_ext(filename)
    return ext.lower()


def is_ignored(path: Path) -> bool:
    """
    Check if a file should be ignored:
    - Hidden files (starts with dot)
    - Subdirectories
    - In-progress / temporary download extensions
    """
    name = path.name
    if name.startswith("."):
        return True

    # Check if ends with any temporary / partial download extension
    lower = name.lower()
    for ign in IGNORE_EXTENSIONS:
        if lower.endswith(ign):
            return True

    return False


def classify_file(path: Path) -> Tuple[str, bool]:
    """
    Determine the category for a file and whether it belongs in user HOME
    or inside a subfolder of Downloads.

    Returns:
        (category_name, is_home_destination)
        Example: ("Documents", True) or ("Archives", False)
    """
    ext = get_file_extension(path.name)

    # 1. Check primary Home directories
    if ext in HOME_EXTENSION_MAP:
        return HOME_EXTENSION_MAP[ext], True

    # 2. Check Downloads subfolders
    if ext in DOWNLOADS_EXTENSION_MAP:
        return DOWNLOADS_EXTENSION_MAP[ext], False

    # 3. Fallback for files without a known home
    return "Other", False


def resolve_destination_dir(
    category: str,
    is_home: bool,
    home_dir: Path,
    downloads_dir: Path,
) -> Path:
    """Resolve the target directory path for a given category."""
    if is_home:
        dest = home_dir / HOME_CATEGORIES.get(category, category)
    else:
        dest = downloads_dir / DOWNLOADS_CATEGORIES.get(category, "Other")
    return dest


def get_collision_free_path(target_dir: Path, filename: str) -> Path:
    """
    Generate a collision-free target Path. If target_dir / filename exists,
    appends (1), (2), ... before the extension (respecting compound extensions).
    """
    candidate = target_dir / filename
    if not candidate.exists():
        return candidate

    stem, ext = split_filename_and_ext(filename)
    counter = 1
    while True:
        candidate = target_dir / f"{stem}({counter}){ext}"
        if not candidate.exists():
            return candidate
        counter += 1


def get_history_file(home_dir: Optional[Path] = None) -> Path:
    """Return the Path to the history JSONL log file."""
    base = home_dir if home_dir else Path.home()
    return base / ".local" / "share" / "sorted" / "history.jsonl"


def append_history(
    src: Path,
    dest: Path,
    category: str,
    home_dir: Optional[Path] = None,
) -> None:
    """Append a record of a moved file to the persistent history file."""
    try:
        hist_path = get_history_file(home_dir)
        hist_path.parent.mkdir(parents=True, exist_ok=True)
        record = {
            "timestamp": time.time(),
            "time_str": datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "filename": src.name,
            "src": str(src),
            "dest": str(dest),
            "category": category,
        }
        with open(hist_path, "a", encoding="utf-8") as f:
            f.write(json.dumps(record) + "\n")
    except Exception as e:
        logger.debug("Failed to append history record: %s", e)


def load_history(home_dir: Optional[Path] = None, limit: int = 10) -> List[Dict[str, Any]]:
    """Load the most recent records from the history log file."""
    hist_path = get_history_file(home_dir)
    if not hist_path.exists():
        return []
    records: List[Dict[str, Any]] = []
    try:
        with open(hist_path, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line:
                    try:
                        records.append(json.loads(line))
                    except json.JSONDecodeError:
                        continue
    except Exception as e:
        logger.debug("Failed to read history: %s", e)
        return []
    return records[-limit:] if limit > 0 else records


def get_history_count(home_dir: Optional[Path] = None) -> int:
    """Count the total number of history records."""
    hist_path = get_history_file(home_dir)
    if not hist_path.exists():
        return 0
    count = 0
    try:
        with open(hist_path, "r", encoding="utf-8") as f:
            for line in f:
                if line.strip():
                    count += 1
    except Exception:
        pass
    return count


def send_notification(title: str, message: str, timeout_ms: int = 4000) -> None:
    """Send a desktop notification via gdbus or dbus-send or notify-send."""
    # 1. Try gdbus (standard freedesktop notification)
    try:
        res = subprocess.run(
            [
                "gdbus",
                "call",
                "--session",
                "--dest",
                "org.freedesktop.Notifications",
                "--object-path",
                "/org/freedesktop/Notifications",
                "--method",
                "org.freedesktop.Notifications.Notify",
                "sorted",
                "0",
                "folder-download",
                title,
                message,
                "[]",
                "{}",
                str(timeout_ms),
            ],
            capture_output=True,
            timeout=2,
        )
        if res.returncode == 0:
            return
    except Exception:
        pass

    # 2. Try AwesomeWM naughty via dbus-send
    try:
        clean_title = json.dumps(title)
        clean_message = json.dumps(message)
        lua_code = f"require('naughty').notify({{ title = {clean_title}, text = {clean_message}, timeout = {timeout_ms / 1000} }})"
        res = subprocess.run(
            [
                "dbus-send",
                "--dest=org.awesomewm.awful",
                "--type=method_call",
                "/",
                "org.awesomewm.awful.Remote.Eval",
                f"string:{lua_code}",
            ],
            capture_output=True,
            timeout=2,
        )
        if res.returncode == 0:
            return
    except Exception:
        pass

    # 3. Try notify-send if installed
    try:
        ns = shutil.which("notify-send")
        if ns:
            subprocess.run([ns, "-t", str(timeout_ms), title, message], timeout=2)
    except Exception:
        pass


def get_downloads_diagnostics(downloads_dir: Path) -> Dict[str, Any]:
    """Inspect downloads_dir to explain why files were or were not sorted."""
    if not downloads_dir.exists() or not downloads_dir.is_dir():
        return {
            "exists": False,
            "loose_files": [],
            "category_dirs": [],
            "other_dirs": [],
            "ignored_files": [],
            "total_items": 0,
        }

    loose_files: List[str] = []
    category_dirs: List[str] = []
    other_dirs: List[str] = []
    ignored_files: List[str] = []

    try:
        entries = sorted(downloads_dir.iterdir(), key=lambda p: p.name.lower())
    except OSError:
        return {
            "exists": True,
            "loose_files": [],
            "category_dirs": [],
            "other_dirs": [],
            "ignored_files": [],
            "total_items": 0,
        }

    for item in entries:
        if item.is_dir():
            if item.name in DOWNLOADS_CATEGORIES:
                category_dirs.append(item.name)
            else:
                other_dirs.append(item.name)
        elif item.is_file() and not item.is_symlink():
            if is_ignored(item):
                ignored_files.append(item.name)
            else:
                loose_files.append(item.name)

    return {
        "exists": True,
        "loose_files": loose_files,
        "category_dirs": category_dirs,
        "other_dirs": other_dirs,
        "ignored_files": ignored_files,
        "total_items": len(entries),
    }


def print_status_report(home_dir: Path, downloads_dir: Path) -> None:
    """Print an exhaustive, human-readable status report."""
    diag = get_downloads_diagnostics(downloads_dir)
    total_sorted = get_history_count(home_dir)
    recent = load_history(home_dir, limit=10)

    print("\n" + "=" * 55)
    print("        Downloads Organizer Status (sorted)        ")
    print("=" * 55)
    print(f"Downloads Directory: {downloads_dir}")
    if not diag["exists"]:
        print("  Status: Directory does not exist!")
    else:
        print(f"  Loose files to sort:       {len(diag['loose_files'])}")
        if diag["loose_files"]:
            print(f"    -> {', '.join(diag['loose_files'][:5])}")
        cat_str = ", ".join(diag["category_dirs"]) if diag["category_dirs"] else "none"
        print(f"  Category subdirectories:   {len(diag['category_dirs'])} ({cat_str})")
        other_str = ", ".join(diag["other_dirs"]) if diag["other_dirs"] else "none"
        print(f"  Folders skipped by design: {len(diag['other_dirs'])} ({other_str})")
        ign_str = ", ".join(diag["ignored_files"]) if diag["ignored_files"] else "none"
        print(f"  In-progress / ignored:     {len(diag['ignored_files'])} ({ign_str})")

    hist_file = get_history_file(home_dir)
    print(f"\nHistory Log: {hist_file}")
    print(f"  Lifetime files organized:  {total_sorted}")

    if recent:
        print("\nRecent Activity (latest first):")
        for rec in reversed(recent):
            time_display = rec.get("time_str", "Unknown time")
            fname = rec.get("filename", "unknown")
            dest = rec.get("dest", "")
            dest_display = dest.replace(str(home_dir), "~")
            cat = rec.get("category", "")
            print(f"  • [{time_display}] {fname} -> {dest_display} ({cat})")
    else:
        print("\nNo recent sorting history recorded yet.")
    print("=" * 55 + "\n")


def sort_file(
    path: Path,
    home_dir: Path,
    downloads_dir: Path,
    dry_run: bool = False,
) -> Optional[Path]:
    """
    Process and move a single file to its appropriate destination.

    Returns:
        The destination Path if moved (or would be moved in dry-run), None if skipped.
    """
    try:
        # Check if path is a regular file and not a symlink/dir
        if not path.is_file() or path.is_symlink():
            return None

        if is_ignored(path):
            logger.debug("Skipping ignored file: %s", path.name)
            return None

        category, is_home = classify_file(path)
        dest_dir = resolve_destination_dir(
            category=category,
            is_home=is_home,
            home_dir=home_dir,
            downloads_dir=downloads_dir,
        )

        dest_path = get_collision_free_path(dest_dir, path.name)

        if dry_run:
            logger.info("[DRY-RUN] Would move '%s' -> '%s'", path, dest_path)
            return dest_path

        # Ensure target directory exists
        dest_dir.mkdir(parents=True, exist_ok=True)

        # Move the file
        shutil.move(str(path), str(dest_path))
        logger.info("Moved '%s' -> '%s'", path.name, dest_path)
        append_history(src=path, dest=dest_path, category=category, home_dir=home_dir)
        return dest_path

    except (PermissionError, OSError) as e:
        logger.error("Failed to move '%s': %s", path, e)
        return None


def run_once(
    home_dir: Path,
    downloads_dir: Path,
    dry_run: bool = False,
    notify: bool = False,
) -> int:
    """
    Perform a single pass over ~/Downloads, sorting all eligible files.
    Returns the count of sorted files.
    """
    if not downloads_dir.exists() or not downloads_dir.is_dir():
        logger.warning("Downloads directory does not exist: %s", downloads_dir)
        return 0

    logger.debug("Scanning '%s'...", downloads_dir)
    sorted_count = 0
    moved_summary: List[str] = []

    try:
        # List entries in downloads_dir (non-recursive)
        entries = sorted(downloads_dir.iterdir(), key=lambda p: p.name.lower())
    except OSError as e:
        logger.error("Error reading directory '%s': %s", downloads_dir, e)
        return 0

    for item in entries:
        # We only sort top-level files in Downloads (do not touch subdirectories)
        if item.is_file() and not item.is_symlink():
            dest = sort_file(item, home_dir, downloads_dir, dry_run=dry_run)
            if dest:
                sorted_count += 1
                moved_summary.append(f"{item.name} -> {dest.parent.name}/{dest.name}")

    if notify and sorted_count > 0:
        summary_text = "\n".join(f"• {s}" for s in moved_summary[:5])
        if len(moved_summary) > 5:
            summary_text += f"\n... and {len(moved_summary) - 5} more"
        send_notification("Downloads Organizer", f"Sorted {sorted_count} file(s):\n{summary_text}")

    return sorted_count


def run_watch(
    home_dir: Path,
    downloads_dir: Path,
    interval: float = 3.0,
    settle_time: float = 2.0,
    dry_run: bool = False,
    notify: bool = False,
) -> None:
    """
    Continuously monitor ~/Downloads for new files and sort them once
    their size has stabilized (ensuring in-progress writes have concluded).
    """
    logger.info("Starting watch daemon on '%s' (interval: %.1fs)...", downloads_dir, interval)

    stop_requested = False

    def handle_signal(sig, frame):  # type: ignore
        nonlocal stop_requested
        logger.info("Received signal %s; shutting down cleanly...", sig)
        stop_requested = True

    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    # Tracks {path: (last_size, last_mtime, first_seen_time)}
    file_tracker: Dict[Path, Tuple[int, float, float]] = {}

    while not stop_requested:
        try:
            if not downloads_dir.exists() or not downloads_dir.is_dir():
                time.sleep(interval)
                continue

            current_files: Set[Path] = set()
            now = time.time()

            for item in downloads_dir.iterdir():
                if not item.is_file() or item.is_symlink():
                    continue
                if is_ignored(item):
                    continue

                current_files.add(item)
                try:
                    stat = item.stat()
                    current_size = stat.st_size
                    current_mtime = stat.st_mtime
                except OSError:
                    continue

                if item not in file_tracker:
                    # First time seeing this file
                    file_tracker[item] = (current_size, current_mtime, now)
                else:
                    prev_size, prev_mtime, first_seen = file_tracker[item]
                    # Check if file has settled (size & mtime unchanged, and present for >= settle_time)
                    if (
                        current_size == prev_size
                        and current_mtime == prev_mtime
                        and (now - first_seen >= settle_time)
                    ):
                        dest = sort_file(item, home_dir, downloads_dir, dry_run=dry_run)
                        file_tracker.pop(item, None)
                        if notify and dest:
                            send_notification("Downloads Organizer", f"Sorted '{item.name}' -> {dest.parent.name}/{dest.name}")
                    else:
                        file_tracker[item] = (current_size, current_mtime, first_seen)

            # Purge tracker entries for files that were moved or deleted
            untracked = [p for p in file_tracker if p not in current_files]
            for p in untracked:
                file_tracker.pop(p, None)

        except Exception as e:
            logger.error("Unexpected error in watch loop: %s", e)

        # Sleep interval in small slices so signal response is instantaneous
        sleep_elapsed = 0.0
        step = 0.2
        while sleep_elapsed < interval and not stop_requested:
            time.sleep(min(step, interval - sleep_elapsed))
            sleep_elapsed += step

    logger.info("Watch daemon stopped.")


def parse_args(argv: Optional[List[str]] = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="sorted",
        description="Organize ~/Downloads into Documents, Pictures, Music, Movies, or categorized subfolders.",
    )
    mode_group = parser.add_mutually_exclusive_group()
    mode_group.add_argument(
        "--once",
        action="store_true",
        default=True,
        help="Run sorting once and exit immediately (default mode).",
    )
    mode_group.add_argument(
        "-w",
        "--watch",
        action="store_true",
        help="Run continuously as a background watcher daemon.",
    )

    parser.add_argument(
        "-s",
        "--status",
        action="store_true",
        help="Show Downloads status, lifetime statistics, and recent activity history.",
    )
    parser.add_argument(
        "--notify",
        action="store_true",
        help="Send desktop notification when files are sorted.",
    )
    parser.add_argument(
        "-n",
        "--dry-run",
        action="store_true",
        help="Display actions without actually moving files.",
    )
    parser.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="Enable verbose / debug log output.",
    )
    parser.add_argument(
        "--downloads-dir",
        type=Path,
        default=Path.home() / "Downloads",
        help="Custom Downloads directory path (default: ~/Downloads).",
    )
    parser.add_argument(
        "--home-dir",
        type=Path,
        default=Path.home(),
        help="Custom Home directory path (default: ~).",
    )
    parser.add_argument(
        "--interval",
        type=float,
        default=3.0,
        help="Polling interval in seconds for --watch mode (default: 3.0).",
    )
    return parser.parse_args(argv)


def main(argv: Optional[List[str]] = None) -> int:
    args = parse_args(argv)

    log_level = logging.DEBUG if args.verbose else logging.INFO
    logging.basicConfig(
        level=log_level,
        format="%(asctime)s [%(levelname)s] %(message)s",
        datefmt="%H:%M:%S",
    )

    home_dir: Path = args.home_dir.resolve()
    downloads_dir: Path = args.downloads_dir.resolve()

    if args.status:
        print_status_report(home_dir=home_dir, downloads_dir=downloads_dir)
        return 0

    if args.watch:
        run_watch(
            home_dir=home_dir,
            downloads_dir=downloads_dir,
            interval=args.interval,
            dry_run=args.dry_run,
            notify=args.notify,
        )
        return 0
    else:
        count = run_once(
            home_dir=home_dir,
            downloads_dir=downloads_dir,
            dry_run=args.dry_run,
            notify=args.notify,
        )
        logger.info("Sorted %d file(s).", count)
        if count == 0 and not args.dry_run:
            diag = get_downloads_diagnostics(downloads_dir)
            details = []
            if diag["other_dirs"]:
                details.append(f"skipped {len(diag['other_dirs'])} folder(s): {', '.join(diag['other_dirs'])}")
            if diag["category_dirs"]:
                details.append(f"{len(diag['category_dirs'])} organized category: {', '.join(diag['category_dirs'])}")
            if diag["ignored_files"]:
                details.append(f"skipped {len(diag['ignored_files'])} in-progress/ignored file(s)")

            if details:
                logger.info("Downloads status: 0 loose files (%s)", "; ".join(details))
            else:
                logger.info("Downloads status: folder is clean (0 items).")

            recent = load_history(home_dir, limit=1)
            if recent:
                last_item = recent[0]
                dest_str = last_item.get("dest", "").replace(str(home_dir), "~")
                logger.info(
                    "Last sorted: '%s' -> '%s' (%s)",
                    last_item.get("filename", ""),
                    dest_str,
                    last_item.get("time_str", ""),
                )
        return 0


if __name__ == "__main__":
    sys.exit(main())
