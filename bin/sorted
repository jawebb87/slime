    ".avif": "Pictures",
    ".xcf": "Pictures",
    ".ai": "Pictures",
    ".eps": "Pictures",
    # Music
    ".mp3": "Music",
    ".flac": "Music",
    ".wav": "Music",
    ".m4a": "Music",
    ".aac": "Music",
    ".ogg": "Music",
    ".oga": "Music",
    ".opus": "Music",
    ".wma": "Music",
    ".alac": "Music",
    ".aiff": "Music",
    ".mid": "Music",
    ".midi": "Music",
    # Movies / Videos
    ".mp4": "Movies",
    ".mkv": "Movies",
    ".avi": "Movies",
    ".mov": "Movies",
    ".wmv": "Movies",
    ".flv": "Movies",
    ".webm": "Movies",
    ".m4v": "Movies",
    ".mpg": "Movies",
    ".mpeg": "Movies",
    ".3gp": "Movies",
    ".ts": "Movies",
    ".vob": "Movies",
}

# Extensions mapped to subdirectories inside ~/Downloads
DOWNLOADS_EXTENSION_MAP: Dict[str, str] = {
    # Archives
    ".tar.gz": "Archives",
    ".tar.bz2": "Archives",
    ".tar.xz": "Archives",
    ".tar.zst": "Archives",
    ".tgz": "Archives",
    ".tbz2": "Archives",
    ".txz": "Archives",
    ".zip": "Archives",
    ".tar": "Archives",
    ".gz": "Archives",
    ".bz2": "Archives",
    ".xz": "Archives",
    ".7z": "Archives",
    ".rar": "Archives",
    ".zst": "Archives",
    ".lz": "Archives",
    ".iso": "Archives",
    ".img": "Archives",
    # Software & Binaries
    ".deb": "Software",
    ".rpm": "Software",
    ".appimage": "Software",
