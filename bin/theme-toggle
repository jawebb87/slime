#!/usr/bin/env bash
# ==============================================================================
# theme-toggle: Switch between Biohazard Slime (Post-Contamination) and
#               Laboratory White (Pre-Contamination) across the entire desktop.
# ==============================================================================

set -eo pipefail

MODE_FILE="$HOME/.config/awesome/theme_mode"
CURRENT="slime"
if [ -f "$MODE_FILE" ]; then
    CURRENT="$(tr -d '[:space:]' < "$MODE_FILE")"
fi

case "${1:-toggle}" in
    lab|white|pre)
        NEXT="lab"
        ;;
    slime|green|post)
        NEXT="slime"
        ;;
    *)
        if [ "$CURRENT" = "lab" ]; then
            NEXT="slime"
        else
            NEXT="lab"
        fi
        ;;
esac

echo "$NEXT" > "$MODE_FILE"

# 1. Kitty Terminal (update config & live-reload all open terminals via SIGUSR1)
if [ -f "$HOME/.config/kitty/${NEXT}.conf" ]; then
    cp -p "$HOME/.config/kitty/${NEXT}.conf" "$HOME/.config/kitty/kitty.conf"
    pkill -USR1 -x kitty 2>/dev/null || true
fi

# 2. Rofi Launcher
if [ -f "$HOME/.config/rofi/${NEXT}.rasi" ]; then
    cp -p "$HOME/.config/rofi/${NEXT}.rasi" "$HOME/.config/rofi/config.rasi"
fi

# 3. Picom Compositor (auto-reloads via inotify)
if [ -f "$HOME/.config/picom/${NEXT}.conf" ]; then
    cp -p "$HOME/.config/picom/${NEXT}.conf" "$HOME/.config/picom/picom.conf"
fi

# 4. Starship Prompt
if [ -f "$HOME/.config/starship-${NEXT}.toml" ]; then
    cp -p "$HOME/.config/starship-${NEXT}.toml" "$HOME/.config/starship.toml"
fi

# 5. Btop System Monitor
if [ -f "$HOME/.config/btop/btop.conf" ]; then
    sed -i "s|^color_theme = .*|color_theme = \"${NEXT}\"|" "$HOME/.config/btop/btop.conf"
fi

# 6. GTK-3.0 / GTK-4.0 dark-theme preference
DARK_PREF="1"
[ "$NEXT" = "lab" ] && DARK_PREF="0"
for gtk_ini in "$HOME/.config/gtk-3.0/settings.ini" "$HOME/.config/gtk-4.0/settings.ini"; do
    if [ -f "$gtk_ini" ]; then
        sed -i "s|^gtk-application-prefer-dark-theme=.*|gtk-application-prefer-dark-theme=${DARK_PREF}|" "$gtk_ini"
    fi
done

# 7. Reset cached Python Tkinter scratchpads so they respawn with the new theme palette
pkill -f "Projects/qtile_bench/.*\.py" 2>/dev/null || true

# 8. Reload AwesomeWM & display theme transition notification
if [ "$NEXT" = "lab" ]; then
    TITLE="Protocol: PRE-CONTAMINATION"
    BODY="Laboratory White theme active (Super+o to toggle)"
else
    TITLE="Alert: BIOLOGICAL CONTAMINATION"
    BODY="Biohazard Slime theme active (Super+o to toggle)"
fi

dbus-send --dest=org.awesomewm.awful --type=method_call / org.awesomewm.awful.Remote.Eval \
    string:"awesome.restart()" 2>/dev/null || true

# Wait briefly for AwesomeWM to finish restarting, then show notification
(
    sleep 0.7
    dbus-send --dest=org.awesomewm.awful --type=method_call / org.awesomewm.awful.Remote.Eval \
        string:"require('naughty').notify({ title = '$TITLE', text = '$BODY', timeout = 4 })" 2>/dev/null || true
) &
