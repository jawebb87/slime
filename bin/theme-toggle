#!/usr/bin/env bash
# ==============================================================================
# theme-toggle: Cycle across the 5-Act Desktop Narrative:
#   Act 0   (origin) : The Specimen Origin / Deep Wood (Forest Soil & Spores)
#   Act I   (lab)    : Pre-Contamination (Laboratory White)
#   Act II  (slime)  : Biological Contamination (Biohazard Slime)
#   Act III (cyber)  : Cyberpunk Future (Obsidian UV + Slime Bio-Reactor)
#   Act IV  (space)  : Orbital Containment / Deep Space Vessel (Hull White & Solar Gold)
# ==============================================================================

set -eo pipefail

MODE_FILE="$HOME/.config/awesome/theme_mode"
CURRENT="slime"
if [ -f "$MODE_FILE" ]; then
    CURRENT="$(tr -d '[:space:]' < "$MODE_FILE")"
fi

case "${1:-toggle}" in
    origin|wood|forest|spore|0)
        NEXT="origin"
        ;;
    lab|white|pre|1)
        NEXT="lab"
        ;;
    slime|green|post|2)
        NEXT="slime"
        ;;
    cyber|cyberpunk|future|uv|3)
        NEXT="cyber"
        ;;
    space|orbit|orbital|vessel|4)
        NEXT="space"
        ;;
    shred|shredder|gunmetal|blade|5)
        NEXT="shred"
        ;;
    chomp|larry|muskrat|haxor|couchlock|6)
        NEXT="chomp"
        ;;
    *)
        if [ "$CURRENT" = "origin" ]; then
            NEXT="lab"
        elif [ "$CURRENT" = "lab" ]; then
            NEXT="slime"
        elif [ "$CURRENT" = "slime" ]; then
            NEXT="cyber"
        elif [ "$CURRENT" = "cyber" ]; then
            NEXT="space"
        elif [ "$CURRENT" = "space" ]; then
            NEXT="shred"
        elif [ "$CURRENT" = "shred" ]; then
            NEXT="chomp"
        else
            NEXT="origin"
        fi
        ;;
esac

echo "$NEXT" > "$MODE_FILE"

# 1. Kitty Terminal (update config & live-reload all open terminals via SIGUSR1)
if [ -f "$HOME/.config/kitty/${NEXT}.conf" ]; then
    cp -p "$HOME/.config/kitty/${NEXT}.conf" "$HOME/.config/kitty/kitty.conf"
    pkill -USR1 -x kitty 2>/dev/null || true
fi

# 2. Rofi Launcher
if [ -f "$HOME/.config/rofi/${NEXT}.rasi" ]; then
    cp -p "$HOME/.config/rofi/${NEXT}.rasi" "$HOME/.config/rofi/config.rasi"
fi

# 3. Picom Compositor (auto-reloads via inotify)
if [ -f "$HOME/.config/picom/${NEXT}.conf" ]; then
    cp -p "$HOME/.config/picom/${NEXT}.conf" "$HOME/.config/picom/picom.conf"
fi

# 4. Starship Prompt
if [ -f "$HOME/.config/starship-${NEXT}.toml" ]; then
    cp -p "$HOME/.config/starship-${NEXT}.toml" "$HOME/.config/starship.toml"
fi

# 5. Btop System Monitor
if [ -f "$HOME/.config/btop/btop.conf" ]; then
    sed -i "s|^color_theme = .*|color_theme = \"${NEXT}\"|" "$HOME/.config/btop/btop.conf"
fi

# 6. GTK-3.0 / GTK-4.0 & GSettings color-scheme and per-theme font preference
if [ "$NEXT" = "lab" ] || [ "$NEXT" = "space" ]; then
    DARK_PREF="0"
    GTK_THEME="Adwaita"
    COLOR_SCHEME="prefer-light"
else
    DARK_PREF="1"
    GTK_THEME="Adwaita-dark"
    COLOR_SCHEME="prefer-dark"
fi

THEME_FONT=""
if [ -f "$HOME/.config/rofi/${NEXT}.rasi" ]; then
    THEME_FONT="$(sed -n -E 's/^[[:space:]]*font:[[:space:]]*"([^"]+)";.*$/\1/p' "$HOME/.config/rofi/${NEXT}.rasi" | head -n 1)"
fi

if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface color-scheme "$COLOR_SCHEME" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface gtk-theme "$GTK_THEME" 2>/dev/null || true
    if [ -n "$THEME_FONT" ]; then
        gsettings set org.gnome.desktop.interface font-name "$THEME_FONT" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface monospace-font-name "$THEME_FONT" 2>/dev/null || true
    fi
fi

for gtk_ini in "$HOME/.config/gtk-3.0/settings.ini" "$HOME/.config/gtk-4.0/settings.ini"; do
    if [ -f "$gtk_ini" ]; then
        sed -i -E "s|^gtk-application-prefer-dark-theme[[:space:]]*=.*|gtk-application-prefer-dark-theme = ${DARK_PREF}|" "$gtk_ini"
        sed -i -E "s|^gtk-theme-name[[:space:]]*=.*|gtk-theme-name = ${GTK_THEME}|" "$gtk_ini"
        if [ -n "$THEME_FONT" ]; then
            sed -i -E "s|^gtk-font-name[[:space:]]*=.*|gtk-font-name = ${THEME_FONT}|" "$gtk_ini"
        fi
    fi
done

# 7. Reset cached Python Tkinter scratchpads so they respawn with the new theme palette
pkill -f '^python3 .*/Projects/qtile_bench/.*\.py$' 2>/dev/null || true

# 8. Reload AwesomeWM & display theme transition notification
if [ "$NEXT" = "origin" ]; then
    TITLE="Act 0: THE SPECIMEN ORIGIN [EXP//LOG]"
    BODY="Deep Wood & Mycelium Spore active (Super+o to cycle)"
elif [ "$NEXT" = "lab" ]; then
    TITLE="Act I: PRE-CONTAMINATION [LAB//SYS]"
    BODY="Laboratory White theme active (Super+o to cycle)"
elif [ "$NEXT" = "slime" ]; then
    TITLE="Act II: BIOLOGICAL CONTAMINATION [BIO//HAZARD]"
    BODY="Biohazard Slime theme active (Super+o to cycle)"
elif [ "$NEXT" = "cyber" ]; then
    TITLE="Act III: CYBERPUNK FUTURE [NET//LINK]"
    BODY="Obsidian UV + Slime Bio-Reactor active (Super+o to cycle)"
elif [ "$NEXT" = "space" ]; then
    TITLE="Act IV: ORBITAL CONTAINMENT [ORB//DECK]"
    BODY="Deep Space Vessel & Cryo-Stasis active (Super+o to cycle)"
elif [ "$NEXT" = "shred" ]; then
    TITLE="Standalone: THE SHREDDER [SHRED//RPM]"
    BODY="Gunmetal, Razor Angles & Rotary Ripper Teeth active (Super+o to cycle)"
else
    TITLE="Standalone: CHOMP THE HAXOR [CHOMP//0x_CHOMP]"
    BODY="Cyber-Swamp Brutalist Console & Full Couchlock active (Super+o to cycle)"
fi

dbus-send --dest=org.awesomewm.awful --type=method_call / org.awesomewm.awful.Remote.Eval \
    string:"awesome.restart()" 2>/dev/null || true

# Wait briefly for AwesomeWM to finish restarting, then show notification
(
    sleep 0.7
    dbus-send --dest=org.awesomewm.awful --type=method_call / org.awesomewm.awful.Remote.Eval \
        string:"require('naughty').notify({ title = '$TITLE', text = '$BODY', timeout = 4 })" 2>/dev/null || true
) &
