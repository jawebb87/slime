#!/usr/bin/env bash
# ==============================================================================
# muppet-pad: Interactive Terminal Dropdown for Muppet Babies
# ==============================================================================
set -e

# Run Muppet Babies ASCII/ANSI banner
if [ -x "$HOME/.local/bin/muppet-fetch" ]; then
    "$HOME/.local/bin/muppet-fetch"
fi

# Keep interactive shell alive
exec "${SHELL:-/bin/zsh}" -i
