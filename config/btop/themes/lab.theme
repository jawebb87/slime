# Laboratory White theme for btop (Pre-Contamination)
# Palette: Sterile white, stark jet-black outlines, clinical blueprint blue/teal, and hazard red

# Main background
theme[main_bg]="#f7f9fb"

# Main text color
theme[main_fg]="#0a0c0e"

# Title color for boxes
theme[title]="#000000"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#0284c7"

# Background color of selected item in processes box
theme[selected_bg]="#0a0c0e"

# Foreground color of selected item in processes box
theme[selected_fg]="#ffffff"

# Color of inactive/disabled text
theme[inactive_fg]="#94a3b8"

# Color of text appearing on top of graphs
theme[graph_text]="#0a0c0e"

# Background color of the percentage meters
theme[meter_bg]="#e2e8f0"

# Misc colors for processes box
theme[proc_misc]="#0284c7"

# Cpu box outline color (stark black)
theme[cpu_box]="#000000"

# Memory/disks box outline color
theme[mem_box]="#000000"

# Net up/down box outline color
theme[net_box]="#000000"

# Processes box outline color
theme[proc_box]="#000000"

# Box divider line and small boxes line color
theme[div_line]="#000000"

# Temperature graph colors
theme[temp_start]="#0284c7"
theme[temp_mid]="#b45309"
theme[temp_end]="#dc2626"

# CPU graph colors
theme[cpu_start]="#0284c7"
theme[cpu_mid]="#0f766e"
theme[cpu_end]="#0a0c0e"

# Mem/Disk free meter
theme[free_start]="#64748b"
theme[free_mid]="#0284c7"
theme[free_end]="#0f766e"

# Mem/Disk cached meter
theme[cached_start]="#64748b"
theme[cached_mid]="#0284c7"
theme[cached_end]="#1d4ed8"

# Mem/Disk available meter
theme[available_start]="#475569"
theme[available_mid]="#0284c7"
theme[available_end]="#0a0c0e"

# Mem/Disk used meter
theme[used_start]="#0284c7"
theme[used_mid]="#b45309"
theme[used_end]="#dc2626"

# Download graph colors
theme[download_start]="#475569"
theme[download_mid]="#0284c7"
theme[download_end]="#0a0c0e"

# Upload graph colors
theme[upload_start]="#64748b"
theme[upload_mid]="#0f766e"
theme[upload_end]="#0a0c0e"

# Process box color gradient
theme[process_start]="#0284c7"
theme[process_mid]="#0f766e"
theme[process_end]="#0a0c0e"
