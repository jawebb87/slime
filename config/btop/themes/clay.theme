theme[hi_fg]="#d49b52"
theme[selected_bg]="#585153"
theme[selected_fg]="#ffffff"
theme[inactive_fg]="#8b817e"
theme[graph_text]="#b6a994"
theme[meter_bg]="#413a3b"
