# "Chomp the Haxor" / CHOMP_0x Cyber-Swamp Theme for btop
# High-Readability Cyber-Tactical Palette

# Main background
theme[main_bg]="#111415"

# Main text color (Crisp, High-Readability Phosphor White)
theme[main_fg]="#e2f5ec"

# Title color for boxes
theme[title]="#39ff14"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#ffb000"

# Background color of selected item in processes box
theme[selected_bg]="#0d2822"

# Foreground color of selected item in processes box
theme[selected_fg]="#39ff14"

# Color of inactive/disabled text (Tactical Visible Slate)
theme[inactive_fg]="#6f8a7e"

# Color of text appearing on top of graphs
theme[graph_text]="#ffffff"

# Background color of the percentage meters
theme[meter_bg]="#181c1d"

# Misc colors for processes box
theme[proc_misc]="#39ff14"

# Box outline colors
theme[cpu_box]="#39ff14"
theme[mem_box]="#1b4539"
theme[net_box]="#1b4539"
theme[proc_box]="#39ff14"

# Box divider line
theme[div_line]="#1b4539"

# Temperature graph colors (Toxic Green -> Hazard Amber -> Alert Red)
theme[temp_start]="#39ff14"
theme[temp_mid]="#ffb000"
theme[temp_end]="#ff0055"

# CPU graph colors (Toxic Green -> Electric Lime -> Alert Amber)
theme[cpu_start]="#39ff14"
theme[cpu_mid]="#6ee7b7"
theme[cpu_end]="#ffb000"

# Mem/Disk free meter (Swamp Teal -> Toxic Green)
theme[free_start]="#1b4539"
theme[free_mid]="#0d2822"
theme[free_end]="#39ff14"

# Mem/Disk cached meter
theme[cached_start]="#181c1d"
theme[cached_mid]="#0d2822"
theme[cached_end]="#6ee7b7"

# Mem/Disk available meter
theme[available_start]="#0d2822"
theme[available_mid]="#245c4c"
theme[available_end]="#39ff14"

# Mem/Disk used meter (Swamp Teal -> Hazard Amber -> Critical Alert Red)
theme[used_start]="#0d2822"
theme[used_mid]="#ffb000"
theme[used_end]="#ff0055"

# Download graph colors
theme[download_start]="#0d2822"
theme[download_mid]="#245c4c"
theme[download_end]="#00ffcc"

# Upload graph colors
theme[upload_start]="#0d2822"
theme[upload_mid]="#ffb000"
theme[upload_end]="#39ff14"

# Process box color gradient
theme[process_start]="#39ff14"
theme[process_mid]="#6ee7b7"
theme[process_end]="#ffb000"
