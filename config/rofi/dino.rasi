/* ============================================================================
 * Rofi Launcher Theme - Dino Might (Radioactive Bruiser & Street Riot)
 * ============================================================================ */

* {
    bg:          #0c0c0ef4;
    bg-alt:      #16161a;
    bg-selected: #76ff03;
    fg:          #f4f4f5;
    fg-selected: #0c0c0e;
    fg-muted:    #a1a1aa;
    border-col:  #76ff03;
    accent:      #ff6d00;
    red:         #ff1744;
    acid-green:  #76ff03;

    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 11";
}

window {
    width:            560px;
    background-color: @bg;
    border:           2px;
    border-color:     @border-col;
    border-radius:    10px;
    padding:          16px;
}

mainbox {
    spacing:  12px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border:           1px;
    border-color:     @border-col;
    border-radius:    8px;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder:       "RADIOACTIVE RIOT // DINO MIGHT...";
    placeholder-color: @fg-muted;
    text-color:        @fg;
}

listview {
    columns:      1;
    lines:        8;
    cycle:        true;
    scrollbar:    false;
    spacing:      6px;
}

element {
    padding:       8px 12px;
    border-radius: 8px;
    spacing:       10px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element normal.urgent {
    background-color: @red;
    text-color:       #ffffff;
}

element normal.active {
    background-color: @bg-alt;
    text-color:       @acid-green;
}

element selected.normal {
    background-color: @bg-selected;
    text-color:       @fg-selected;
}

element selected.urgent {
    background-color: @red;
    text-color:       #ffffff;
}

element selected.active {
    background-color: @accent;
    text-color:       #0c0c0e;
}

element-icon {
    size: 24px;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}
