/* ============================================================================
 * Rofi Launcher Theme - Crust (Crustpunk Drifter & Alleyway Phantom)
 * ============================================================================ */

* {
    bg:          #0f0e0ff4;
    bg-alt:      #1a1716;
    bg-selected: #f4d06f;
    fg:          #f5f5f4;
    fg-selected: #0f0e0f;
    fg-muted:    #a8a29e;
    border-col:  #f4d06f;
    accent:      #d97706;
    crimson:     #991b1b;
    moss:        #65a30d;

    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 11";
}

window {
    width:            560px;
    background-color: @bg;
    border:           2px;
    border-color:     @border-col;
    border-radius:    10px;
    padding:          16px;
}

mainbox {
    spacing:  12px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border:           1px;
    border-color:     @border-col;
    border-radius:    8px;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder:       "CRUSTPUNK ALLEY // CRUST...";
    placeholder-color: @fg-muted;
    text-color:        @fg;
}

listview {
    columns:      1;
    lines:        8;
    cycle:        true;
    scrollbar:    false;
    spacing:      6px;
}

element {
    padding:       8px 12px;
    border-radius: 8px;
    spacing:       10px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element normal.urgent {
    background-color: @crimson;
    text-color:       #ffffff;
}

element normal.active {
    background-color: @bg-alt;
    text-color:       @moss;
}

element selected.normal {
    background-color: @bg-selected;
    text-color:       @fg-selected;
}

element selected.urgent {
    background-color: @crimson;
    text-color:       #ffffff;
}

element selected.active {
    background-color: @accent;
    text-color:       #0f0e0f;
}

element-icon {
    size: 24px;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}
