/* ============================================================================
 * Rofi Launcher Theme - Teenage Mutant Ninja Turtles (TMNT)
 * ============================================================================ */

* {
    bg:          #0e1510f4;
    bg-alt:      #152218;
    bg-selected: #39ff14;
    fg:          #d8ebd8;
    fg-selected: #0e1510;
    fg-muted:    #5a7d5f;
    border-col:  #39ff14;
    accent:      #ffd700;
    leo:         #00aaff;
    raph:        #ff2a4b;
    donnie:      #9d4edd;
    mikey:       #ff8800;

    background-color: transparent;
    text-color:       @fg;
    font:             "ComicShannsMono Nerd Font 11";
}

window {
    width:            560px;
    background-color: @bg;
    border:           2px;
    border-color:     @border-col;
    border-radius:    10px;
    padding:          16px;
}

mainbox {
    spacing:  12px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border:           1.5px;
    border-color:     @accent;
    border-radius:    8px;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @accent;
    font:             "ComicShannsMono Nerd Font Bold 11";
}

entry {
    placeholder:       "COWABUNGA // SEARCH MANHATTAN & SEWER LAIR...";
    placeholder-color: @fg-muted;
    text-color:        @fg;
}

listview {
    columns:      1;
    lines:        8;
    cycle:        true;
    scrollbar:    false;
    spacing:      6px;
}

element {
    padding:       8px 12px;
    border-radius: 8px;
    spacing:       10px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element normal.urgent {
    background-color: @raph;
    text-color:       #ffffff;
}

element normal.active {
    background-color: @bg-alt;
    text-color:       @leo;
}

element selected.normal {
    background-color: @bg-selected;
    text-color:       @fg-selected;
}

element selected.urgent {
    background-color: @raph;
    text-color:       #ffffff;
}

element selected.active {
    background-color: @accent;
    text-color:       #0e1510;
}

element-icon {
    size: 24px;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}
