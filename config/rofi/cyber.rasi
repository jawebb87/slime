configuration {
    modi: "drun,run,window";
    font: "ZedMono Nerd Font 10";
    show-icons: true;
    display-drun: "  ";
    display-run: "  ";
    display-window: "  ";
    drun-display-format: "{name}";
}

@theme "/dev/null"

* {
    bg-col:  #090812f5;
    bg-col-light: #161326;
    border-col: #a855f7;
    selected-col: #161326;
    acid-cyan: #00f0ff;
    toxic-slime: #55f736;
    fg-col: #e0d8f6;
    fg-col-bright: #ffffff;
    grey: #7928ca;

    width: 600;
    margin: 0;
    padding: 0;
}

element-text, element-icon , mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    height: 380px;
    border: 1px;
    border-color: @border-col;
    border-radius: 2px;
    background-color: @bg-col;
    padding: 15px;
}

mainbox {
    background-color: transparent;
}

inputbar {
    children: [prompt,entry];
    background-color: @bg-col-light;
    border: 1px;
    border-color: @grey;
    border-radius: 2px;
    padding: 2px;
    margin: 0 0 10px 0;
}

prompt {
    background-color: @border-col;
    padding: 8px 12px;
    text-color: #090812;
    border-radius: 2px;
    margin: 4px;
}

entry {
    padding: 8px;
    margin: 4px;
    text-color: @acid-cyan;
    background-color: transparent;
}

listview {
    border: 0px;
    padding: 6px 0px;
    margin: 10px 0px 0px 20px;
    columns: 1;
    lines: 6;
    background-color: transparent;
}

element {
    padding: 8px 12px;
    background-color: transparent;
    text-color: @fg-col;
    border-radius: 2px;
}

element-icon {
    size: 22px;
    margin: 0 10px 0 0;
}

element selected {
    background-color: @selected-col;
    text-color: @acid-cyan;
    border: 1px;
    border-color: @border-col;
}

mode-switcher {
    spacing: 0;
}

button {
    padding: 8px;
    background-color: @bg-col-light;
    text-color: @grey;
    vertical-align: 0.5;
    horizontal-align: 0.5;
    border-radius: 2px;
    margin: 4px;
}

button selected {
    background-color: @selected-col;
    text-color: @toxic-slime;
    border: 1px;
    border-color: @toxic-slime;
}
