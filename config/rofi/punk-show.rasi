/* ============================================================================
 * Rofi Launcher Theme - Punk Show! (Sound Check)
 * ============================================================================ */

* {
    bg:          #161815f4;
    bg-alt:      #272a24;
    bg-selected: #ef4148;
    fg:          #ddd7c0;
    fg-selected: #161815;
    fg-muted:    #9c9e8b;
    border-col:  #ef4148;
    accent:      #f46b66;
    gold:        #d1ac63;
    neon-blue:   #91ad6e;

    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 11";
}

window {
    width:            560px;
    background-color: @bg;
    border:           2px;
    border-color:     @border-col;
    border-radius: 2px;
    padding:          16px;
}

mainbox {
    spacing:  12px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border:           1px;
    border-color:     @border-col;
    border-radius: 2px;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder:       "SOUND CHECK // PATCH IN...";
    placeholder-color: @fg-muted;
    text-color:        @fg;
}

listview {
    columns:      1;
    lines:        8;
    cycle:        true;
    scrollbar:    false;
    spacing:      6px;
}

element {
    padding:       8px 12px;
    border-radius: 2px;
    spacing:       10px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element normal.urgent {
    background-color: @accent;
    text-color:       #ffffff;
}

element normal.active {
    background-color: @bg-alt;
    text-color:       @neon-blue;
}

element selected.normal {
    background-color: @bg-selected;
    text-color:       @fg-selected;
}

element selected.urgent {
    background-color: @accent;
    text-color:       #ffffff;
}

element selected.active {
    background-color: @neon-blue;
    text-color:       @fg-selected;
}

element-icon {
    size: 24px;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}
