/* ============================================================================
 * Rofi Launcher Theme - Wake & Bake (420 Special)
 * ============================================================================ */

* {
    bg:          #111618f5;
    bg-alt:      #16201e;
    bg-selected: #48b852;
    fg:          #e5dfd5;
    fg-selected: #0d1411;
    fg-muted:    #70857b;
    border-col:  #48b852;
    accent:      #48b852;
    cyan:        #4ee2ec;
    amber:       #f4a226;
    crimson:     #e63946;

    background-color: transparent;
    text-color:       @fg;
    font:             "ComicShannsMono Nerd Font 11";
}

window {
    width:            560px;
    background-color: @bg;
    border:           2px;
    border-color:     @border-col;
    border-radius:    10px;
    padding:          16px;
}

mainbox {
    spacing:  12px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border:           1.5px;
    border-color:     @accent;
    border-radius:    8px;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @accent;
    font:             "ComicShannsMono Nerd Font Bold 11";
}

entry {
    placeholder:       "WAKE & BAKE 420 // SEARCH THE SESH...";
    placeholder-color: @fg-muted;
    text-color:        @fg;
}

listview {
    columns:      1;
    lines:        8;
    cycle:        true;
    scrollbar:    false;
    spacing:      6px;
}

element {
    padding:       8px 12px;
    border-radius: 8px;
    spacing:       10px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element normal.urgent {
    background-color: @crimson;
    text-color:       #ffffff;
}

element normal.active {
    background-color: @bg-alt;
    text-color:       @accent;
}

element selected.normal {
    background-color: @bg-selected;
    text-color:       @fg-selected;
}

element selected.urgent {
    background-color: @crimson;
    text-color:       #ffffff;
}

element selected.active {
    background-color: @accent;
    text-color:       #0d1411;
}

element-icon {
    size: 24px;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}
