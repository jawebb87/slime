/* ============================================================================
 * Rofi Configuration - Act 0: The Specimen Origin / Deep Wood
 * ============================================================================ */

configuration {
    modi:                       "drun,run,window";
    show-icons:                 true;
    display-drun:               "🍄 Specimen";
    display-run:                "🌿 Field";
    display-window:             "🌲 Canopy";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
    font:                       "MonaspiceRn Nerd Font 10";
}

* {
    bg:                         #141712;
    bg-alt:                     #241e17;
    fg:                         #d8dee9;
    fg-dim:                     #5a784d;
    accent:                     #9ece6a;
    urgent:                     #d08770;

    background-color:           transparent;
    text-color:                 @fg;
    margin:                     0px;
    padding:                    0px;
    spacing:                    0px;
}

window {
    location:                   center;
    anchor:                     center;
    width:                      540px;
    background-color:           @bg;
    border:                     2px solid;
    border-color:               @accent;
    border-radius:              10px;
}

mainbox {
    padding:                    16px;
    spacing:                    12px;
    children:                   [ "inputbar", "listview" ];
}

inputbar {
    background-color:           @bg-alt;
    border:                     1px solid;
    border-color:               @fg-dim;
    border-radius:              8px;
    padding:                    10px 14px;
    spacing:                    10px;
    children:                   [ "prompt", "entry" ];
}

prompt {
    text-color:                 @accent;
    font:                       "MonaspiceRn Nerd Font 10";
}

entry {
    placeholder:                "Search field log...";
    placeholder-color:          @fg-dim;
    text-color:                 @fg;
}

listview {
    columns:                    1;
    lines:                      8;
    fixed-height:               true;
    dynamic:                    true;
    scrollbar:                  false;
    spacing:                    4px;
}

element {
    padding:                    8px 12px;
    spacing:                    12px;
    border-radius:              6px;
}

element normal.normal {
    background-color:           transparent;
    text-color:                 @fg;
}

element alternate.normal {
    background-color:           transparent;
    text-color:                 @fg;
}

element selected.normal {
    background-color:           @bg-alt;
    text-color:                 @accent;
    border:                     1px solid;
    border-color:               @accent;
}

element-icon {
    size:                       24px;
    vertical-align:             0.5;
}

element-text {
    vertical-align:             0.5;
    text-color:                 inherit;
}
