/* ============================================================================
 * Rofi Launcher Theme - Molly Tov (Street Riot & Anarchy)
 * ============================================================================ */

* {
    bg:          #0f0d0ef4;
    bg-alt:      #1e1a1c;
    bg-selected: #f77f00;
    fg:          #f1faee;
    fg-selected: #0f0d0e;
    fg-muted:    #a8dadc;
    border-col:  #f77f00;
    accent:      #e63946;
    gold:        #fcbf49;
    acid-green:  #70e000;

    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 11";
}

window {
    width:            560px;
    background-color: @bg;
    border:           2px;
    border-color:     @border-col;
    border-radius:    10px;
    padding:          16px;
}

mainbox {
    spacing:  12px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border:           1px;
    border-color:     @border-col;
    border-radius:    8px;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder:       "STREET RIOT // MOLLY TOV...";
    placeholder-color: @fg-muted;
    text-color:        @fg;
}

listview {
    columns:      1;
    lines:        8;
    cycle:        true;
    scrollbar:    false;
    spacing:      6px;
}

element {
    padding:       8px 12px;
    border-radius: 8px;
    spacing:       10px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element normal.urgent {
    background-color: @accent;
    text-color:       #ffffff;
}

element normal.active {
    background-color: @bg-alt;
    text-color:       @acid-green;
}

element selected.normal {
    background-color: @bg-selected;
    text-color:       @fg-selected;
}

element selected.urgent {
    background-color: @accent;
    text-color:       #ffffff;
}

element selected.active {
    background-color: @accent;
    text-color:       #ffffff;
}

element-icon {
    size: 24px;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}
