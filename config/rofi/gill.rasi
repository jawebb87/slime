/* ============================================================================
 * Rofi Launcher Theme - Baron von Gill (Subterranean Grotto)
 * ============================================================================ */

* {
    bg:          #080e15f4;
    bg-alt:      #0c1520;
    bg-selected: #00f5d4;
    fg:          #cbd5e1;
    fg-selected: #080e15;
    fg-muted:    #475569;
    border-col:  #00f5d4;
    accent:      #fb7185;
    gold:        #fbbf24;
    neon-blue:   #38bdf8;

    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 11";
}

window {
    width:            560px;
    background-color: @bg;
    border:           2px;
    border-color:     @border-col;
    border-radius:    10px;
    padding:          16px;
}

mainbox {
    spacing:  12px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border:           1px;
    border-color:     @border-col;
    border-radius:    8px;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder:       "GROTTO // BARON VON GILL...";
    placeholder-color: @fg-muted;
    text-color:        @fg;
}

listview {
    columns:      1;
    lines:        8;
    cycle:        true;
    scrollbar:    false;
    spacing:      6px;
}

element {
    padding:       8px 12px;
    border-radius: 8px;
    spacing:       10px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element normal.urgent {
    background-color: @accent;
    text-color:       #ffffff;
}

element normal.active {
    background-color: @bg-alt;
    text-color:       @neon-blue;
}

element selected.normal {
    background-color: @bg-selected;
    text-color:       @fg-selected;
}

element selected.urgent {
    background-color: @accent;
    text-color:       #ffffff;
}

element selected.active {
    background-color: @neon-blue;
    text-color:       @fg-selected;
}

element-icon {
    size: 24px;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}
