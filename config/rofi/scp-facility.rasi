/* ============================================================================
 * Rofi Launcher Theme - SCP Facility (Something Answered)
 * ============================================================================ */

* {
    bg:          #0b0f12f4;
    bg-alt:      #1a2228;
    bg-selected: #d6584d;
    fg:          #d8e1e5;
    fg-selected: #0b0f12;
    fg-muted:    #93a3ad;
    border-col:  #d6584d;
    accent:      #ff7564;
    gold:        #d5af58;
    neon-blue:   #8dbdc9;

    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 11";
}

window {
    width:            560px;
    background-color: @bg;
    border:           2px;
    border-color:     @border-col;
    border-radius: 2px;
    padding:          16px;
}

mainbox {
    spacing:  12px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border:           1px;
    border-color:     @border-col;
    border-radius: 2px;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder:       "SCP FACILITY // AUTHORIZED ACCESS";
    placeholder-color: @fg-muted;
    text-color:        @fg;
}

listview {
    columns:      1;
    lines:        8;
    cycle:        true;
    scrollbar:    false;
    spacing:      6px;
}

element {
    padding:       8px 12px;
    border-radius: 2px;
    spacing:       10px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element normal.urgent {
    background-color: @accent;
    text-color:       #ffffff;
}

element normal.active {
    background-color: @bg-alt;
    text-color:       @neon-blue;
}

element selected.normal {
    background-color: @bg-selected;
    text-color:       @fg-selected;
}

element selected.urgent {
    background-color: @accent;
    text-color:       #ffffff;
}

element selected.active {
    background-color: @neon-blue;
    text-color:       @fg-selected;
}

element-icon {
    size: 24px;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}
