/* ============================================================================
 * Rofi Launcher Theme - Speedster and Crew (Cozy Cartoon Hangout)
 * ============================================================================ */

* {
    bg:          #140d0df5;
    bg-alt:      #241513;
    bg-selected: #cb6d25;
    fg:          #f9cda7;
    fg-selected: #140d0d;
    fg-muted:    #8a6d5f;
    border-col:  #cb6d25;
    accent:      #dd9868;
    crimson:     #d93829;
    violet:      #8330b7;

    background-color: transparent;
    text-color:       @fg;
    font:             "ComicShannsMono Nerd Font 11";
}

window {
    width:            560px;
    background-color: @bg;
    border:           2px;
    border-color:     @border-col;
    border-radius:    10px;
    padding:          16px;
}

mainbox {
    spacing:  12px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border:           1.5px;
    border-color:     @accent;
    border-radius:    8px;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @accent;
    font:             "ComicShannsMono Nerd Font Bold 11";
}

entry {
    placeholder:       "SPEEDSTER & CREW // SEARCH CLUBHOUSE...";
    placeholder-color: @fg-muted;
    text-color:        @fg;
}

listview {
    columns:      1;
    lines:        8;
    cycle:        true;
    scrollbar:    false;
    spacing:      6px;
}

element {
    padding:       8px 12px;
    border-radius: 8px;
    spacing:       10px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element normal.urgent {
    background-color: @crimson;
    text-color:       #ffffff;
}

element normal.active {
    background-color: @bg-alt;
    text-color:       @accent;
}

element selected.normal {
    background-color: @bg-selected;
    text-color:       @fg-selected;
}

element selected.urgent {
    background-color: @crimson;
    text-color:       #ffffff;
}

element selected.active {
    background-color: @accent;
    text-color:       #140d0d;
}

element-icon {
    size: 24px;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}
